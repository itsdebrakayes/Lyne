# LYNE - Root Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# MySQL (used by Docker Compose)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=qme_now
MYSQL_USER=lyne
MYSQL_PASSWORD=lyne_secret

# Supabase (Auth only - used by backend API to verify JWTs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Backend API
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Website Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_API_URL=http://localhost:4000/api

# Tenant-scoped analytics worker
PIPELINE_EMAIL=pipeline@your-domain.com
PIPELINE_PASSWORD=use-a-long-random-password
PIPELINE_BUSINESS_ID=your-business-uuid
PIPELINE_TIMEZONE=America/Jamaica
