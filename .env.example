# LYNE - Root Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# MySQL (used by Docker Compose)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=lyne
MYSQL_USER=lyne
MYSQL_PASSWORD=lyne_secret

# Supabase (Auth only - used by backend API to verify JWTs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Text messages. Nothing is sent unless SMS_ENABLED=true.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Most texts one number can get in an hour, and the whole system in a day.
SMS_PER_NUMBER_PER_HOUR=4
SMS_DAILY_CAP=200

# Backend API
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Website Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_API_URL=http://localhost:4000/api

# Tenant-scoped analytics worker
PIPELINE_EMAIL=pipeline@your-domain.com
PIPELINE_PASSWORD=use-a-long-random-password
PIPELINE_BUSINESS_ID=your-business-uuid
PIPELINE_TIMEZONE=America/Jamaica

# ── Web account portal ────────────────────────────────────────────────────
# Signs the short-lived token the mobile app carries to /account. There is no
# default on purpose: a handoff signed with a value published in this repo
# would be forgeable by anyone who has read it, and "it worked in development"
# is how that reaches production. The backend treats anything shorter than 32
# characters as unconfigured and refuses to issue.
#   openssl rand -base64 48
PORTAL_HANDOFF_SECRET=

# Where the portal lives. Used for Stripe's success/cancel/return URLs.
FRONTEND_URL=

# App update notice (GET /api/app/version). Below LATEST: a dismissable notice; below
# MINIMUM: it stays. No URL = no notice for that store (iOS until it is approved).
APP_IOS_LATEST=
APP_IOS_MINIMUM=
APP_IOS_URL=
APP_ANDROID_LATEST=
APP_ANDROID_MINIMUM=
APP_ANDROID_URL=https://play.google.com/store/apps/details?id=com.lyne.mobile
