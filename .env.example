# Q ME NOW - Root Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# MySQL (used by Docker Compose)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=qmenow
MYSQL_USER=qmenow
MYSQL_PASSWORD=qmenow_secret

# Supabase (Auth only - used by backend API to verify JWTs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Backend API
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Website Frontend (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_API_URL=http://localhost:4000/api
