{
  "info": {
    "name": "LYNE — Backend API",
    "description": "Complete Postman collection for the LYNE Express/MySQL backend API.\n\n## Setup\n1. Import this collection into Postman.\n2. Set the `base_url` variable to `http://localhost:4000/api`.\n3. Set the `token` variable to a valid Supabase JWT (sign in via the website or mobile app and copy the access token from localStorage or AsyncStorage).\n4. Run the **Auth / Sync User** request first to ensure your MySQL user record exists.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "lyne-api-v1"
  },
  "variable": [
    { "key": "base_url",    "value": "http://localhost:4000/api", "type": "string" },
    { "key": "token",       "value": "YOUR_SUPABASE_JWT",         "type": "string" },
    { "key": "business_id", "value": "biz-taj-001",               "type": "string" },
    { "key": "branch_id",   "value": "",                          "type": "string" },
    { "key": "service_id",  "value": "",                          "type": "string" },
    { "key": "queue_id",    "value": "",                          "type": "string" },
    { "key": "ticket_id",   "value": "",                          "type": "string" },
    { "key": "staff_id",    "value": "",                          "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/../health", "host": ["{{base_url}}"], "path": ["..","health"] },
            "description": "Returns `{status: 'ok'}` if the API is running."
          }
        }
      ]
    },

    {
      "name": "Auth",
      "item": [
        {
          "name": "Sync User (POST /auth/sync-user)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/auth/sync-user", "host": ["{{base_url}}"], "path": ["auth","sync-user"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Jane Smith\",\n  \"phone\": \"+18761234567\",\n  \"national_id\": \"123456789\",\n  \"trn\": \"987654321\"\n}"
            },
            "description": "Called after every Supabase signup/login. Creates or updates the MySQL user record. Idempotent."
          }
        },
        {
          "name": "Get Current User (GET /auth/me)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth","me"] },
            "description": "Returns the MySQL user or staff record for the authenticated caller."
          }
        }
      ]
    },

    {
      "name": "Businesses",
      "item": [
        {
          "name": "List Businesses (GET /businesses)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/businesses",
              "host": ["{{base_url}}"],
              "path": ["businesses"],
              "query": [
                { "key": "search", "value": "TAJ", "disabled": true },
                { "key": "limit",  "value": "10",  "disabled": true },
                { "key": "offset", "value": "0",   "disabled": true }
              ]
            },
            "description": "Public endpoint. Returns all active businesses. Supports `?search=` query param."
          }
        },
        {
          "name": "Get Business (GET /businesses/:id)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/businesses/{{business_id}}", "host": ["{{base_url}}"], "path": ["businesses","{{business_id}}"] }
          }
        },
        {
          "name": "Create Business (POST /businesses)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/businesses", "host": ["{{base_url}}"], "path": ["businesses"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Business\",\n  \"description\": \"A description\",\n  \"primary_color\": \"#3b82f6\",\n  \"tier_id\": \"tier-basic-001\"\n}"
            },
            "description": "Requires executive role."
          }
        }
      ]
    },

    {
      "name": "Branches",
      "item": [
        {
          "name": "List Branches (GET /branches)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/branches?business_id={{business_id}}",
              "host": ["{{base_url}}"],
              "path": ["branches"],
              "query": [{ "key": "business_id", "value": "{{business_id}}" }]
            },
            "description": "Public. Returns all active branches for a business."
          }
        },
        {
          "name": "Get Branch (GET /branches/:id)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/branches/{{branch_id}}", "host": ["{{base_url}}"], "path": ["branches","{{branch_id}}"] }
          }
        },
        {
          "name": "Create Branch (POST /branches)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/branches", "host": ["{{base_url}}"], "path": ["branches"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_id\": \"{{business_id}}\",\n  \"name\": \"New Branch\",\n  \"address\": \"123 Main St\",\n  \"city\": \"Kingston\",\n  \"parish\": \"Kingston\",\n  \"phone\": \"+18761234567\",\n  \"open_time\": \"08:00:00\",\n  \"close_time\": \"16:00:00\"\n}"
            }
          }
        },
        {
          "name": "Update Branch (PUT /branches/:id)",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/branches/{{branch_id}}", "host": ["{{base_url}}"], "path": ["branches","{{branch_id}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Branch Name\"\n}" }
          }
        }
      ]
    },

    {
      "name": "Services",
      "item": [
        {
          "name": "List Services (GET /services)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/services?business_id={{business_id}}",
              "host": ["{{base_url}}"],
              "path": ["services"],
              "query": [{ "key": "business_id", "value": "{{business_id}}" }]
            },
            "description": "Public. Returns all active services for a business."
          }
        },
        {
          "name": "Get Service (GET /services/:id)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/services/{{service_id}}", "host": ["{{base_url}}"], "path": ["services","{{service_id}}"] }
          }
        },
        {
          "name": "Create Service (POST /services)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/services", "host": ["{{base_url}}"], "path": ["services"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_id\": \"{{business_id}}\",\n  \"name\": \"New Service\",\n  \"description\": \"Service description\",\n  \"avg_service_minutes\": 10,\n  \"ticket_prefix\": \"N\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Queues",
      "item": [
        {
          "name": "List Queues (GET /queues)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/queues?branch_id={{branch_id}}",
              "host": ["{{base_url}}"],
              "path": ["queues"],
              "query": [
                { "key": "branch_id",   "value": "{{branch_id}}" },
                { "key": "business_id", "value": "{{business_id}}", "disabled": true }
              ]
            },
            "description": "Returns today's queues for a branch with live wait counts."
          }
        },
        {
          "name": "Get Queue (GET /queues/:id)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/queues/{{queue_id}}", "host": ["{{base_url}}"], "path": ["queues","{{queue_id}}"] }
          }
        },
        {
          "name": "Open Queue (POST /queues)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/queues", "host": ["{{base_url}}"], "path": ["queues"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_id\": \"{{business_id}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"service_id\": \"{{service_id}}\",\n  \"queue_date\": \"2026-05-01\",\n  \"max_capacity\": 200\n}"
            },
            "description": "Opens a new queue for today. Requires manager or executive role."
          }
        },
        {
          "name": "Close Queue (PUT /queues/:id/close)",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/queues/{{queue_id}}/close", "host": ["{{base_url}}"], "path": ["queues","{{queue_id}}","close"] },
            "description": "Closes a queue. No more tickets can be issued."
          }
        }
      ]
    },

    {
      "name": "Tickets",
      "item": [
        {
          "name": "Join Queue / Issue Ticket (POST /tickets)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/tickets", "host": ["{{base_url}}"], "path": ["tickets"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_id\": \"{{business_id}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"service_id\": \"{{service_id}}\",\n  \"intake_data\": {\n    \"full_name\": \"Jane Smith\",\n    \"trn\": \"987654321\"\n  }\n}"
            },
            "description": "Issues a ticket and returns ticket_number + estimated wait. Creates a wait_time_record row."
          }
        },
        {
          "name": "Get Ticket (GET /tickets/:id)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/tickets/{{ticket_id}}", "host": ["{{base_url}}"], "path": ["tickets","{{ticket_id}}"] },
            "description": "Returns ticket with live position and estimated wait."
          }
        },
        {
          "name": "List Tickets for Queue (GET /tickets)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/tickets?queue_id={{queue_id}}&status=waiting",
              "host": ["{{base_url}}"],
              "path": ["tickets"],
              "query": [
                { "key": "queue_id", "value": "{{queue_id}}" },
                { "key": "status",   "value": "waiting" }
              ]
            },
            "description": "Returns all tickets in a queue. Requires staff role."
          }
        },
        {
          "name": "Update Ticket Status (PUT /tickets/:id/status)",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/tickets/{{ticket_id}}/status", "host": ["{{base_url}}"], "path": ["tickets","{{ticket_id}}","status"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_status\": \"called\",\n  \"counter_id\": \"counter-id-here\",\n  \"notes\": \"Optional staff notes\"\n}"
            },
            "description": "Transitions ticket status. Valid values: `called`, `serving`, `completed`, `cancelled`, `no_show`. Requires staff role."
          }
        },
        {
          "name": "Call Next Ticket (POST /tickets/call-next)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/tickets/call-next", "host": ["{{base_url}}"], "path": ["tickets","call-next"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"queue_id\": \"{{queue_id}}\",\n  \"counter_id\": \"counter-id-here\"\n}"
            },
            "description": "Calls the next waiting ticket in the queue. Requires staff role."
          }
        }
      ]
    },

    {
      "name": "Staff",
      "item": [
        {
          "name": "List Staff (GET /staff)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/staff?business_id={{business_id}}",
              "host": ["{{base_url}}"],
              "path": ["staff"],
              "query": [{ "key": "business_id", "value": "{{business_id}}" }]
            },
            "description": "Returns all staff for a business. Requires manager or executive role."
          }
        },
        {
          "name": "Get Staff Member (GET /staff/:id)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/staff/{{staff_id}}", "host": ["{{base_url}}"], "path": ["staff","{{staff_id}}"] }
          }
        },
        {
          "name": "Create Staff (POST /staff)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/staff", "host": ["{{base_url}}"], "path": ["staff"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_id\": \"{{business_id}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"full_name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"role_id\": \"role-line-staff-001\"\n}"
            },
            "description": "Creates a staff record. Requires manager or executive role."
          }
        },
        {
          "name": "Update Staff (PUT /staff/:id)",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/staff/{{staff_id}}", "host": ["{{base_url}}"], "path": ["staff","{{staff_id}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"role_id\": \"role-manager-001\"\n}" }
          }
        }
      ]
    },

    {
      "name": "Staff Assignments",
      "item": [
        {
          "name": "List Assignments (GET /assignments)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/assignments?branch_id={{branch_id}}&date=2026-05-01",
              "host": ["{{base_url}}"],
              "path": ["assignments"],
              "query": [
                { "key": "branch_id", "value": "{{branch_id}}" },
                { "key": "date",      "value": "2026-05-01" }
              ]
            }
          }
        },
        {
          "name": "Create Assignment (POST /assignments)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/assignments", "host": ["{{base_url}}"], "path": ["assignments"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"staff_id\": \"{{staff_id}}\",\n  \"business_id\": \"{{business_id}}\",\n  \"branch_id\": \"{{branch_id}}\",\n  \"counter_id\": \"counter-id-here\",\n  \"assignment_date\": \"2026-05-01\",\n  \"shift_start\": \"08:00:00\",\n  \"shift_end\": \"16:00:00\"\n}"
            }
          }
        }
      ]
    },

    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Analytics Summary (GET /analytics/summary)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/analytics/summary?business_id={{business_id}}&period=week",
              "host": ["{{base_url}}"],
              "path": ["analytics","summary"],
              "query": [
                { "key": "business_id", "value": "{{business_id}}" },
                { "key": "period",      "value": "week",  "description": "day | week | month" },
                { "key": "branch_id",   "value": "",      "disabled": true }
              ]
            },
            "description": "Returns aggregated analytics. Requires manager or executive role."
          }
        },
        {
          "name": "Get Peak Hours Heatmap (GET /analytics/heatmap)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/analytics/heatmap?business_id={{business_id}}",
              "host": ["{{base_url}}"],
              "path": ["analytics","heatmap"],
              "query": [{ "key": "business_id", "value": "{{business_id}}" }]
            }
          }
        },
        {
          "name": "Get Service Performance (GET /analytics/services)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/analytics/services?business_id={{business_id}}",
              "host": ["{{base_url}}"],
              "path": ["analytics","services"],
              "query": [{ "key": "business_id", "value": "{{business_id}}" }]
            }
          }
        },
        {
          "name": "Get Staff Performance (GET /analytics/staff)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/analytics/staff?business_id={{business_id}}",
              "host": ["{{base_url}}"],
              "path": ["analytics","staff"],
              "query": [{ "key": "business_id", "value": "{{business_id}}" }]
            }
          }
        },
        {
          "name": "Get Branch Comparison (GET /analytics/branches)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/analytics/branches?business_id={{business_id}}",
              "host": ["{{base_url}}"],
              "path": ["analytics","branches"],
              "query": [{ "key": "business_id", "value": "{{business_id}}" }]
            },
            "description": "Cross-branch comparison. Requires executive role."
          }
        }
      ]
    },

    {
      "name": "Predictions",
      "item": [
        {
          "name": "Get Predictions (GET /predictions)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/predictions?business_id={{business_id}}&insight_type=best_time_to_visit",
              "host": ["{{base_url}}"],
              "path": ["predictions"],
              "query": [
                { "key": "business_id",  "value": "{{business_id}}" },
                { "key": "insight_type", "value": "best_time_to_visit", "description": "best_time_to_visit | peak_hours | service_performance | branch_performance_trend" }
              ]
            },
            "description": "Returns the latest prediction result for a business. Public for best_time_to_visit."
          }
        },
        {
          "name": "Write Prediction (POST /predictions)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/predictions", "host": ["{{base_url}}"], "path": ["predictions"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_id\": \"{{business_id}}\",\n  \"insight_type\": \"best_time_to_visit\",\n  \"insight_data\": {\n    \"recommendation\": \"Aim for mid-week mornings\",\n    \"best_slot\": { \"dow\": 2, \"hour\": 9, \"expected_wait_minutes\": 5 }\n  }\n}"
            },
            "description": "Writes a prediction result from the Jupyter model. Requires executive role or service token."
          }
        }
      ]
    },

    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications (GET /notifications)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/notifications",
              "host": ["{{base_url}}"],
              "path": ["notifications"],
              "query": [
                { "key": "unread_only", "value": "true", "disabled": true }
              ]
            },
            "description": "Returns notifications for the authenticated user."
          }
        },
        {
          "name": "Mark Notification Read (PUT /notifications/:id/read)",
          "request": {
            "method": "PUT",
            "url": { "raw": "{{base_url}}/notifications/NOTIFICATION_ID/read", "host": ["{{base_url}}"], "path": ["notifications","NOTIFICATION_ID","read"] }
          }
        },
        {
          "name": "Send Notification (POST /notifications)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/notifications", "host": ["{{base_url}}"], "path": ["notifications"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"USER_ID\",\n  \"ticket_id\": \"{{ticket_id}}\",\n  \"type\": \"called\",\n  \"title\": \"Your turn!\",\n  \"body\": \"Please proceed to counter 3.\"\n}"
            },
            "description": "Sends a notification. Requires staff role."
          }
        }
      ]
    },

    {
      "name": "Visit History",
      "item": [
        {
          "name": "Get Visit History (GET /history)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/history?limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["history"],
              "query": [
                { "key": "limit",  "value": "20" },
                { "key": "offset", "value": "0"  }
              ]
            },
            "description": "Returns visit history for the authenticated user."
          }
        }
      ]
    },

    {
      "name": "Saved Businesses",
      "item": [
        {
          "name": "List Saved Businesses (GET /saved)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/saved", "host": ["{{base_url}}"], "path": ["saved"] },
            "description": "Returns saved businesses for the authenticated user."
          }
        },
        {
          "name": "Save Business (POST /saved)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/saved", "host": ["{{base_url}}"], "path": ["saved"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"business_id\": \"{{business_id}}\"\n}" }
          }
        },
        {
          "name": "Remove Saved Business (DELETE /saved/:business_id)",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/saved/{{business_id}}", "host": ["{{base_url}}"], "path": ["saved","{{business_id}}"] }
          }
        }
      ]
    }

  ]
}
