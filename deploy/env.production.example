# ─────────────────────────────────────────────────────────────────────────────
#  LYNE — production environment
#
#  Copy to the repository root on the droplet as `.env` (that name is
#  gitignored) and fill in. Compose reads it automatically.
#
#      cp deploy/env.production.example .env && nano .env
#
#  Nothing in here has a safe default on purpose: every value marked REQUIRED
#  fails the container at start rather than booting with a development value and
#  looking fine. A production box that comes up on a dev secret is worse than
#  one that refuses to come up.
# ─────────────────────────────────────────────────────────────────────────────

# ── Where this is ───────────────────────────────────────────────────────────
APP_TZ=America/Jamaica

API_DOMAIN=api.uselyne.com
ADMIN_DOMAIN=admin.uselyne.com
# Let's Encrypt sends expiry and problem notices here. Use a mailbox a person
# reads, not an alias nobody has opened since setup.
TLS_EMAIL=customersupport@uselyne.com

# ── Managed MySQL ───────────────────────────────────────────────────────────
# From the database's Connection Details panel. Use the PRIVATE host
# (private-*.db.ondigitalocean.com): it keeps the traffic on the VPC and off the
# public internet, and it does not count against bandwidth.
MYSQL_HOST=private-REPLACE.b.db.ondigitalocean.com
MYSQL_PORT=25060
MYSQL_USER=lyne
MYSQL_PASSWORD=REQUIRED
MYSQL_DATABASE=lyne

# TLS is not optional on a managed database — it refuses plaintext. Download the
# CA certificate from that same panel and save it as secrets/mysql-ca.crt in the
# repository root on the droplet (the secrets/ directory is gitignored).
MYSQL_SSL=true

# ── Supabase (authentication only) ──────────────────────────────────────────
SUPABASE_URL=https://edavcmrruwxnmzktvwoz.supabase.co
SUPABASE_PUBLISHABLE_KEY=REQUIRED
# Server only. This key bypasses row-level security; it must never be built into
# the mobile app, the admin bundle, or anything a browser downloads.
SUPABASE_SERVICE_KEY=REQUIRED

# ── URLs and CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=https://admin.uselyne.com
# Exact origins, comma-separated, no trailing slashes and no wildcard. The
# marketing site is included because the public web-join flow posts from it.
ALLOWED_ORIGINS=https://admin.uselyne.com,https://uselyne.com,https://www.uselyne.com

# One proxy (Caddy) in front of the API.
TRUST_PROXY=1

# ── Secrets ─────────────────────────────────────────────────────────────────
# Generate FRESH for production, never copied from a development machine:
#     openssl rand -base64 48
PORTAL_HANDOFF_SECRET=REQUIRED

# ── Scheduled jobs ──────────────────────────────────────────────────────────
TICKET_EXPIRY_ENABLED=true
TICKET_EXPIRY_GRACE_MINUTES=30
RETENTION_ENABLED=true

# ── Analytics worker ────────────────────────────────────────────────────────
# The worker signs in to the API as a real account to read what it needs.
PIPELINE_EMAIL=
PIPELINE_PASSWORD=
PIPELINE_BUSINESS_ID=
PIPELINE_TIMEZONE=America/Jamaica

# ── Deliberately absent ─────────────────────────────────────────────────────
# ALLOW_DEMO_DATA_REFRESH — demo boxes only. Setting it here would arm a data
#   refresh against real customer records. It is double-gated; leave it unset
#   anyway, and let the absence be the third gate.
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET — payments are stubbed pending a
#   Jamaican processor. Adding keys here does not turn payments on.
