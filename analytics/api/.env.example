# Q ME NOW Analytics API — Environment Variables
# Copy to .env and fill in your values

# Server
ANALYTICS_PORT=5000
ENV=development

# Internal API key (shared with the main backend)
ANALYTICS_API_KEY=change-me-to-a-long-random-secret

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=qmenow
DB_PASSWORD=your-db-password
DB_NAME=qmenow

# Backend URL (for CORS)
BACKEND_URL=http://localhost:4000
