# ── MySQL connection ──────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=lyne
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=lyne

# ── Backend API ───────────────────────────────────────────────
API_URL=http://localhost:4000/api

# ── Supabase (for pipeline authentication only) ───────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key

# ── Pipeline executive account ────────────────────────────────
# Create a dedicated staff account with role=executive for the pipeline.
# Used by import_predictions.py to POST results to the API.
# Never use a personal executive account here.
PIPELINE_EMAIL=pipeline@your-domain.com
PIPELINE_PASSWORD=your_strong_pipeline_password
PIPELINE_BUSINESS_ID=your-business-uuid-here
PIPELINE_TIMEZONE=America/Jamaica

# ── Per-business IDs (add one per pilot client) ───────────────
# BUSINESS_ID_TAJ=biz-taj-001
# BUSINESS_ID_NHT=biz-nht-001
# BUSINESS_ID_PICA=biz-pica-001
