# ── LYNE Backend — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ── MySQL Database ────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=lyne

# ── Supabase (Auth verification only) ────────────────────────────────────────
# The backend uses the SERVICE ROLE key to verify JWTs server-side.
# This key is NEVER sent to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Stripe (Payments) ────────────────────────────────────────────────────────
# Until these are set, payment endpoints return 503 "not configured" and the
# rest of the app is unaffected. The SECRET key stays server-side; the mobile
# app uses the PUBLISHABLE key (EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY) to tokenize.
STRIPE_SECRET_KEY=sk_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
PREMIUM_PRICE_CENTS=999
PREMIUM_CURRENCY=usd
