# ── Q ME NOW Backend — Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── MySQL Database ────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=qme_now

# ── Supabase (Auth verification only) ────────────────────────────────────────
# The backend uses the SERVICE ROLE key to verify JWTs server-side.
# This key is NEVER sent to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
