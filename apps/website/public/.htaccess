# Apache config for the Lyne marketing site. GoDaddy shared hosting is Apache,
# and this file has to sit in the same directory as index.html — Vite copies
# everything in public/ to the root of dist/, so it ends up in the right place.
#
# Without the rewrite below, the site works at / and 404s on every other path:
# /about, /privacy, /terms and /account are React Router routes, not files on
# disk, so Apache looks for a directory called "about", does not find one, and
# serves its own 404 instead of handing the request to the app.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Real files and directories are served as-is. This has to come first, or the
  # catch-all below would swallow the JS and CSS bundles and hand back HTML —
  # which the browser refuses to execute as a module, and the page renders
  # blank with a MIME type error in the console.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is the single-page app.
  RewriteRule . /index.html [L]
</IfModule>

# Vite fingerprints every asset filename, so a hashed file can be cached hard
# and forever — the name changes when the content does. index.html must NOT be
# cached, or a returning visitor keeps loading an old HTML that points at asset
# names the server no longer has, and gets a blank page from a stale cache.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Some shared hosts still serve .mjs and .webmanifest as text/plain, which stops
# a module script from executing at all.
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# Compress text assets. GoDaddy does not always do this by default and the main
# bundle is ~500 kB uncompressed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
