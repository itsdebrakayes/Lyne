# apps/website — build-time configuration.
#
# Vite INLINES these at build time. They are not read at runtime, so setting
# them on the server after a build changes nothing — the values must be present
# in the environment of whatever runs `npm run build`.
#
# .env is gitignored, so a host that clones this repo and builds has none of
# them unless they are set in the host's build settings.

# Supabase. Both are publishable client keys — the same pair already committed
# in apps/mobile/app.json. They are safe in a bundle; the service-role key is
# not and must never appear here.
VITE_SUPABASE_URL=https://edavcmrruwxnmzktvwoz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_DlwXt8oEDcFNrYFmOMsxGA_z7qU9cXA

# Where the Lyne API lives, including the /api suffix. Without it the site falls
# back to a relative /api, which only works if the API is served from the same
# origin as the site.
VITE_API_URL=https://your-api-host.example.com/api

# The site's own public origin, with no trailing slash. Read by
# scripts/generate-sitemap.mjs (which runs after `vite build`) to write
# sitemap.xml, the Sitemap line in robots.txt, and the absolute canonical,
# Open Graph and JSON-LD urls in the built index.html. Unlike the values above
# it is NOT inlined into the bundle — useSeo.ts reads the live origin instead,
# so a preview deploy canonicalises to itself.
#
# Defaults to https://uselyne.com when unset. Override it for a staging or
# preview host so that host does not claim to be production.
VITE_SITE_URL=https://uselyne.com
