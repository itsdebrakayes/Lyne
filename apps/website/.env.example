# ── Q ME NOW Frontend — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# ── Supabase (Auth only) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Backend API ───────────────────────────────────────────────────────────────
# Points to the Q ME NOW Express backend (Node.js + MySQL).
# In development: http://localhost:4000/api
# In production:  https://api.yourdomain.com/api
VITE_API_URL=http://localhost:4000/api

# Dedicated administration dashboard
VITE_ADMIN_URL=http://localhost:5174
