# ── LYNE Marketing Website — Environment Variables ────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.

# The public website is marketing-only. It must not point to the queue backend,
# Supabase Auth, or the desktop admin app.
VITE_APP_STORE_URL=https://www.apple.com/app-store/
VITE_PLAY_STORE_URL=https://play.google.com/store
VITE_CONTACT_EMAIL=customersupport@uselyne.com
