        "android.permission.READ_MEDIA_AUDIO",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 1,
          "backgroundColor": "#0C1B40",
          "dark": {
            "backgroundColor": "#0C1B40"
          },
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#1A4BD8",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lyne uses your location while the app is open to estimate when you should leave for the branch. It stays on your phone.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "LYNE uses the camera to scan your ID, TRN or passport.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LYNE lets you upload a photo of your ID, TRN or passport.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "LYNE uses Face ID to protect your saved documents."
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      "@bacons/apple-targets"
    ],
