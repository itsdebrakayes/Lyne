{
  "expo": {
    "name": "LYNE",
    "slug": "lyne",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "scheme": "lyne",
    "primaryColor": "#1b4b8f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lyne.mobile",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LYNE uses your location to estimate when you should leave for your queue.",
        "NSUserNotificationUsageDescription": "LYNE sends queue updates and departure reminders.",
        "NSCameraUsageDescription": "LYNE uses the camera to scan your ID, TRN or passport so agencies can verify you faster.",
        "NSPhotoLibraryUsageDescription": "LYNE lets you upload a photo or document of your ID, TRN or passport.",
        "NSFaceIDUsageDescription": "LYNE uses Face ID to protect your saved documents and sensitive details.",
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
